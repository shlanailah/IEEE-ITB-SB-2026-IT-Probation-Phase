# ============================================================================
# IEEE ITB Student Branch — Environment Variable Template
# ----------------------------------------------------------------------------
# NOTE: This project is a static frontend (vanilla JS) with no build step,
# so the values below are NOT read from a .env file at runtime.
# This file serves as a TEMPLATE/reference of the required variables.
# The actual values must be pasted directly into js/config.js:
#
#   window.SUPABASE_URL      -> SUPABASE_URL
#   window.SUPABASE_ANON_KEY -> SUPABASE_ANON_KEY
#
# Get the values from: Supabase Dashboard -> Project Settings -> API
# (NOT the service_role key — the anon/publishable key is meant to be public)
# ============================================================================

# Your Supabase project URL, e.g. https://abcdxyz.supabase.co
SUPABASE_URL=

# Supabase anon/public (publishable) key — safe for frontends,
# data access is still restricted by Row Level Security.
SUPABASE_ANON_KEY=